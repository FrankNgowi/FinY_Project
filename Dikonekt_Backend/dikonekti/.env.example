# Copy to .env, fill in, and load it into your shell before running manage.py:
#   set -a; . ./.env; set +a
# The server does not read this file itself. Never commit the real .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required.
DJANGO_DB_NAME=Dikonekti
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=

# Optional (defaults shown).
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Local development only. Leave unset (off) anywhere else.
DJANGO_DEBUG=true

# Comma-separated host names. Required when DJANGO_DEBUG is off.
# With DJANGO_DEBUG on and this unset, only localhost and 127.0.0.1 are allowed.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins allowed to call the API from a browser, e.g. https://app.example.com
# Empty means none. The Next.js app and the mobile app do not need an entry.
CORS_ALLOWED_ORIGINS=

# Optional: where rate-limit counters are stored (default: a folder in the system temp directory).
DJANGO_CACHE_DIR=

# Optional: number of trusted reverse proxies in front of Django (default 0).
# 0 ignores X-Forwarded-For, so clients cannot fake their address to dodge the register limit.
DJANGO_NUM_PROXIES=
